<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for production backend (HTTP) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhelperbackend-env.eba-xsu7rune.ap-south-1.elasticbeanstalk.com</domain>
    </domain-config>
    <!-- Allow cleartext for all local/dev traffic (IPs don't work in domain-config) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
